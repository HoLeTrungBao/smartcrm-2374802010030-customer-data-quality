# Cấu hình môi trường cho Pipeline kiểm tra và làm sạch dữ liệu khách hàng (Luồng L7)

# Môi trường chạy: dev / staging / prod
APP_ENV=dev
LOG_LEVEL=INFO

# Đường dẫn thư mục dữ liệu nguồn
DATA_DIR=data/raw

# Đường dẫn cơ sở dữ liệu SQLite kho dữ liệu Star Schema
DATABASE_URL=sqlite:///data/processed/warehouse.db

# Đường dẫn thư mục báo cáo chất lượng sinh tự động
REPORTS_DIR=reports

# Cấu hình chặn khi chất lượng không đạt ngưỡng (true / false)
BLOCK_ON_QUALITY_FAILURE=false