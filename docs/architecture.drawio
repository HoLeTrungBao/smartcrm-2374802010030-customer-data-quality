        <mxCell id="tab_fact" value="fact_customer_quality_audit&#xa;(Grain: 1 record / 1 audit run / 1 rule)&#xa;audit_id, is_passed, quality_score" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#854D0E;" vertex="1" parent="layer3">
          <mxGeometry x="40" y="32" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tab_dim_cust" value="dim_customer&#xa;(record_id, ho_ten_clean,&#xa;sdt_clean, email_clean, status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#854D0E;" vertex="1" parent="layer3">
          <mxGeometry x="330" y="35" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tab_dim_rules" value="dim_quality_rule &amp; dim_audit_run&#xa;(Danh mục quy tắc DQ &amp; Lịch sử đợt chạy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#854D0E;" vertex="1" parent="layer3">
          <mxGeometry x="600" y="35" width="250" height="55" as="geometry" />
