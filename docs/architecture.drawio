        <mxCell id="dash_2" value="Khung 2: Phân tích trùng lặp &amp; lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECDD3;strokeColor=#E11D48;fontColor=#9F1239;" vertex="1" parent="layer5">
