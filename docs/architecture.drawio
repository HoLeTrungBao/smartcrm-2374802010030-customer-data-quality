        <!-- LEGEND BOX -->
        <mxCell id="legend" value="CHÚ THÍCH KÝ HIỆU (LEGEND)&#xa;[ Khung hình chữ nhật ] = Phân tầng kiến trúc&#xa;[ Hình trụ ] = Bảng dữ liệu / Kho Data Warehouse&#xa;[ Đường mũi tên ] = Luồng trao đổi dữ liệu giữa các tầng&#xa;[ Khung viền nét đứt ] = Giới hạn ngoài phạm vi hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;" vertex="1" parent="1">
