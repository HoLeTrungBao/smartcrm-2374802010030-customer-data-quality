        <!-- OUT OF SCOPE BOX -->
        <mxCell id="scope_box" value="PHẦN NGOÀI PHẠM VI HỆ THỐNG (OUT OF SCOPE)&#xa;-------------------------------------------------------------------------------------------------------------------&#xa;• Hệ thống xử lý giao dịch bán lẻ tại điểm bán (POS Transactional Database)&#xa;• Cổng thanh toán trực tuyến Core Banking Mekong&#xa;• Dịch vụ SMS Brandname / Email Automation tự động gửi tin nhắn cho khách hàng&#xa;• Hệ thống quản lý bảo hành và tiếp nhận linh kiện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;align=left;fontSize=11;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="655" width="880" height="85" as="geometry" />
