        <!-- Arrow Layer 4 -> Layer 5 -->
        <mxCell id="arrow4" value="REST API / Data View Render" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#7E22CE;fontSize=11;" edge="1" parent="1" source="layer4" target="layer5">
          <mxGeometry relative="1" as="geometry" />
