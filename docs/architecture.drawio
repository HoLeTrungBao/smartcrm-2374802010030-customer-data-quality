        <!-- Arrow Layer 3 -> Layer 4 -->
        <mxCell id="arrow3" value="SQL Aggregations &amp; KPI Metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA8A04;strokeWidth=2;fontColor=#A16207;fontSize=11;" edge="1" parent="1" source="layer3" target="layer4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 4: Semantic Layer -->
        <mxCell id="layer4" value="4. TẦNG NGHIỆP VỤ &amp; CHỈ SỐ PHÂN TÍCH (SEMANTIC &amp; ANALYTICS LAYER)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;fontStyle=1;fontColor=#581C87;startSize=26;" vertex="1" parent="1">
