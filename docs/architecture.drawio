        <mxCell id="dash_3" value="Khung 3: Tiến độ làm sạch dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECDD3;strokeColor=#E11D48;fontColor=#9F1239;" vertex="1" parent="layer5">
