        <mxCell id="layer5" value="5. TẦNG TRÌNH DIỄN (PRESENTATION / BI DASHBOARD LAYER)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontStyle=1;fontColor=#881337;startSize=26;" vertex="1" parent="1">
