        <!-- Header -->
        <mxCell id="title" value="LƯỢC ĐỒ KHO DỮ LIỆU - STAR SCHEMA (TRACK DA)&#xa;Hệ thống Smart CRM - Quản lý chất lượng dữ liệu khách hàng" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Grain Statement Box -->
        <mxCell id="grain_box" value="TUYÊN BỐ MỨC ĐỘ HẠT (GRAIN):&#xa;Mỗi dòng trong bảng Fact fact_customer_quality_audit đại diện cho kết quả kiểm định chất lượng của MỘT bản ghi khách hàng (record_id) trong MỘT phiên chạy (run_key) theo MỘT quy tắc chất lượng (rule_key)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="860" height="45" as="geometry" />
        </mxCell>

