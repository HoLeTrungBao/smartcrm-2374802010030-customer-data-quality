        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam class {\n    BackgroundColor White\n    ArrowColor Black\n    BorderColor Black\n}\n\n&#39; Tiêu đề sơ đồ\ntitle LƯỢC ĐỒ KHO DỮ LIỆU - STAR SCHEMA (TRACK DA)\\nHệ thống Smart CRM - Quản lý chất lượng dữ liệu khách hàng\n\n&#39; Ghi chú mức độ hạt (Grain)\nnote \&quot;&lt;b&gt;TUYÊN BỐ MỨC ĐỘ HẠT (GRAIN):&lt;/b&gt;\\nMỗi dòng trong bảng Fact fact_customer_quality_audit đại diện cho kết quả kiểm định chất lượng của MỘT bản ghi khách hàng (record_id) trong MỘT phiên chạy (run_key) theo MỘT quy tắc chất lượng (rule_key).\&quot; as NoteGrain #FFF2CC\n\n&#39; Bảng dim_audit_run\nentity \&quot;dim_audit_run\\n(Bảng chiều Phiên kiểm định)\&quot; as dim_audit_run #E1F5FE {\n    + PK run_key : INT\n    --\n    run_date : TIMESTAMP\n    total_records : INT\n    run_by : VARCHAR(100)\n}\n\n&#39; Bảng dim_customer\nentity \&quot;dim_customer\\n(Bảng chiều Khách hàng)\&quot; as dim_customer #E8EAF6 {\n    + PK customer_key : INT\n    --\n    record_id : BIGINT\n    ho_ten_goc : VARCHAR(255)\n    ho_ten_clean : VARCHAR(255)\n    so_dien_thoai_goc : VARCHAR(50)\n    so_dien_thoai_clean : VARCHAR(15)\n    email_clean : VARCHAR(255)\n    dia_chi_clean : VARCHAR(500)\n    ngay_tao : DATE\n    status : VARCHAR(50)\n}\n\n&#39; Bảng dim_quality_rule\nentity \&quot;dim_quality_rule\\n(Bảng chiều Danh mục Quy tắc)\&quot; as dim_quality_rule #FFF8E1 {\n    + PK rule_key : INT\n    --\n    rule_code : VARCHAR(10)\n    rule_name : VARCHAR(100)\n    target_column : VARCHAR(50)\n    severity : VARCHAR(20)\n}\n\n&#39; Bảng fact_customer_quality_audit\nentity \&quot;fact_customer_quality_audit\\n(Bảng Fact Sự kiện kiểm định)\&quot; as fact_customer_quality_audit #FFEBEE {\n    + PK audit_id : BIGINT\n    --\n    + FK customer_key : INT\n    + FK run_key : INT\n    + FK rule_key : INT\n    is_passed : BOOLEAN\n    is_missing : BOOLEAN\n    is_invalid_format : BOOLEAN\n    is_duplicate : BOOLEAN\n    is_auto_cleaned : BOOLEAN\n    quality_score : DECIMAL(5,2)\n}\n\n&#39; Quan hệ giữa các bảng\ndim_audit_run \&quot;1\&quot; &lt;-- \&quot;N\&quot; fact_customer_quality_audit\ndim_customer \&quot;1\&quot; &lt;-- \&quot;N\&quot; fact_customer_quality_audit\ndim_quality_rule \&quot;1\&quot; &lt;-- \&quot;N\&quot; fact_customer_quality_audit\n\n&#39; Chú thích dưới cùng\nlegend bottom left\n&lt;b&gt;CHÚ THÍCH KÝ HIỆU &amp; QUAN HỆ:&lt;/b&gt;\n• PK (Primary Key): Khóa chính của bảng\n• FK (Foreign Key): Khóa ngoại tham chiếu bảng chiều (Dimension)\n• Quan hệ 1 : N: Mỗi bản ghi trong bảng chiều nối với nhiều bản ghi kiểm định trong bảng sự kiện (Fact)\n• Cấu trúc Star Schema đạt chuẩn mô hình hóa kho dữ liệu của Ralph Kimball.\nendlegend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wsfPBXpB6-uwQdOY3ss9-1">
