  <diagram name="Trang-1" id="nm2os7cZ_NCLAvZ-OFuB">
    <mxGraphModel dx="1893" dy="1214" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
